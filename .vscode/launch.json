{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: API",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "api",
        "--watch"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "env": {
      "NODE_ENV": "development"
      },
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: Mailer",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "mailer",
        "--watch"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "env": {
        "NODE_ENV": "development"
      },
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: Lambda local",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "runtimeArgs": [
        "-r", "tsconfig-paths/register",
        "-r", "ts-node/register"
      ],
      "program": "${workspaceFolder}/apps/worker/src/lambda.test.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "preLaunchTask": "clean-dist"
    }
  ]
}
