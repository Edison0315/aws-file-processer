{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: API",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "api",
        "--watch"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "env": {
      "NODE_ENV": "development"
      },
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: Mailer",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "mailer",
        "--watch"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "env": {
        "NODE_ENV": "development"
      },
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS: Worker",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.12.0/bin/node",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "worker",
        "--watch"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "env": {
        "NODE_ENV": "development"
      },
      "restart": true
    }
  ]
}
