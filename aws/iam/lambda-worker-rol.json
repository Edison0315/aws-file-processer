{
  "Version": "2012-10-17",
  "Statement": [
      {
          "Sid": "S3AndSqsAndSns",
          "Effect": "Allow",
          "Action": [
              "s3:GetObject",
              "s3:PutObject",
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:GetQueueAttributes",
              "sqs:ChangeMessageVisibility",
              "sns:Publish"
          ],
          "Resource": [
              "*"
          ]
      },
      {
          "Sid": "LogsLambda",
          "Effect": "Allow",
          "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
          ],
          "Resource": "*"
      }
  ]
}